<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="eus.ehu.hotelreservation.ui.ReserveRoomController">
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Reserve Room" VBox.vgrow="NEVER" />

    <GridPane hgap="10" vgap="10" VBox.vgrow="NEVER">
        <GridPane.margin>
            <Insets bottom="0" left="20" right="20" top="20" />
        </GridPane.margin>
        <Label text="Hotel:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="hotelComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0"
                  accessibleText="Hotel selection"
                  accessibleRole="COMBO_BOX"
                  accessibleHelp="Select a hotel" />
        <Label text="Start Date:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <DatePicker fx:id="startDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="0"
                    accessibleText="Start date picker"
                    accessibleHelp="Select the check-in date" />
        <Label text="End Date:" GridPane.columnIndex="4" GridPane.rowIndex="0" />
        <DatePicker fx:id="endDatePicker" GridPane.columnIndex="5" GridPane.rowIndex="0"
                    accessibleText="End date picker"
                    accessibleHelp="Select the check-out date" />
        <Button fx:id="searchButton" onAction="#searchAvailability" text="Search Availability" GridPane.columnIndex="6" GridPane.rowIndex="0"
                accessibleText="Search Availability"
                accessibleRole="BUTTON"
                accessibleHelp="Search for available rooms" />
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <TableView fx:id="roomsTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="hotelColumn" text="Hotel" />
            <TableColumn fx:id="roomTypeColumn" text="Room Type" />
            <TableColumn fx:id="dailyPriceColumn" text="Daily Price (€)" />
            <TableColumn fx:id="totalPriceColumn" text="Total Price (€)" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER">
        <HBox.margin>
            <Insets bottom="20" left="20" right="20" top="20" />
        </HBox.margin>
        <Label fx:id="infoLabel" text="Select a hotel and dates, then search for available rooms." />
        <Button fx:id="reserveButton" text="Reserve (Pay 20%)"
                accessibleText="Reserve (Pay 20%)"
                accessibleRole="BUTTON"
                accessibleHelp="Reserve the selected room type with 20% upfront payment" />
        <Button fx:id="waitingListButton" text="Join Waiting List"
                accessibleText="Join Waiting List"
                accessibleRole="BUTTON"
                accessibleHelp="Join the waiting list if no rooms available" />
    </HBox>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
