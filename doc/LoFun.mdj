					],
					"documentation": "# Gertaera Fluxua: Logela libreak kontsultatu\n1. Erabiltzaileak hiria, sarrera eta irteera egunak ipintzen ditu.\n2. Sistemak hiri horretan dauden Hotelak bilatzen ditu.\n3. Sistemak hotel bakoitzeko, logela libreak bilatzen du, hau da, erreserbak ez daukatenak tarte horretan.\n4. Sistemal aurkitutako Logela bakoitzeko bere logela mota bilatzen du, eta eskatutako eguneko tarifa aurkezten du. \n5. Erabiltzaileak logela mota bat aukeratu dezake eta nahi badu extends Erreserba egin \n",
					"extensionPoints": [
						{
							"_type": "UMLExtensionPoint",
							"_id": "AAAAAAFq/hA7cGMJeU0=",
							"_parent": {
								"$ref": "AAAAAAFq5M3x6YjI7Mk="
							},
							"name": "erreserba egin nahi badu"
						}
					]
				},
