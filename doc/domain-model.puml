@startuml DomainModel
title Domain Model — Hotel Chain Reservation System
hide circle
skinparam classAttributeIconSize 0

class HotelChain {
  -name : String
}

class Hotel {
  -name : String
  -category : String
  -phone : String
  -email : String
  -web : String
}

class Address {
  -street : String
  -city : String
  -postalCode : String
  -country : String
}

class Room {
  -number : String
}

enum RoomType {
  SIMPLE
  DOUBLE
  TRIPLE
  SUITE
}

class DailyPrice {
  -date : Date
  -amount : Money
}

class AdditionalDayPrice {
  -amount : Money
}

class User {
  -name : String
}

class RegisteredUser {
  -username : String
  -email : String
  -password : String
}

class CreditCard {
  -number : String
  -holderName : String
  -expiryDate : Date
  -cvv : String
}

class Reservation {
  -startDate : Date
  -endDate : Date
  -totalPrice : Money
  -status : ReservationStatus
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

class Payment {
  -amount : Money
  -date : DateTime
  -type : PaymentType
}

enum PaymentType {
  ADVANCE_20
  REMAINING_80
  LATE_CHECKOUT
}

class WaitingListEntry {
  -requestDate : DateTime
  -startDate : Date
  -endDate : Date
}

class CheckIn {
  -entryDateTime : DateTime
}

class CheckOut {
  -exitDateTime : DateTime
  -lateCheckout : Boolean
}

class AccessCard {
  -code : String
}

class Worker {
  -employeeId : String
  -name : String
}

HotelChain "1" *-- "1..*" Hotel
Hotel "1" -- "1" Address
Hotel "1" *-- "1..*" Room
Hotel "1" -- "*" Worker : employs >
Hotel "1" *-- "*" DailyPrice
Hotel "1" *-- "4" AdditionalDayPrice

Room "*" -- "1" RoomType
DailyPrice "*" -- "1" RoomType
AdditionalDayPrice "*" -- "1" RoomType

RegisteredUser --|> User
RegisteredUser "1" -- "1..*" CreditCard
RegisteredUser "1" -- "*" Reservation : makes >
RegisteredUser "1" -- "*" WaitingListEntry

Reservation "*" -- "1" Hotel
Reservation "*" -- "1" RoomType
Reservation "0..*" -- "0..1" Room : assigned >
Reservation "1" *-- "1..*" Payment
Reservation "1" -- "0..1" CheckIn
Reservation "1" -- "0..1" CheckOut

Payment "*" -- "1" CreditCard : charged to >

WaitingListEntry "*" -- "1" Hotel
WaitingListEntry "*" -- "1" RoomType

CheckIn "1" -- "1..*" AccessCard : delivers >
CheckIn "*" -- "1" Worker : performed by >
CheckOut "*" -- "1" Worker : performed by >
@enduml