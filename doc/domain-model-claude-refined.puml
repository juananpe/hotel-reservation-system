@startuml DomainModel
title Domain Model — Hotel Chain Reservation System (refined)
hide circle
skinparam classAttributeIconSize 0

class Hotel {
  +name
  +category
  +address
  +phone
  +email
}

class Room {
  +number
  +status
}

class RoomType {
  +type
}

class Rate {
  +rateCode
  +dailyPrice
  +startDate
  +endDate
}

class Reservation {
  +reservationCode
  +reservationStart
  +reservationEnd
  +checkIn
  +checkOut
  +amountDue
  +amountPaid
}

class Customer {
  +nationalId
  +name
  +creditCard
}

class WaitingListEntry {
  +entryCode
  +requestedOn
  +fromDate
  +toDate
}

' --- Association class carrying the late-day price per (hotel, room type) ---
class HotelRoomType {
  +additionalDayPrice
}

' --- Structural relationships ---
Hotel         "1"    -- "0..*" Room
Room          "0..*" -- "1"    RoomType
Hotel         "0..*" -- "0..*" RoomType
(Hotel, RoomType) .. HotelRoomType

RoomType      "1"    -- "0..*" Rate : rates

' --- Reservations ---
Room          "1"    -- "0..*" Reservation
Customer      "1"    -- "0..*" Reservation

' --- Waiting list: tied to a room TYPE at a hotel, not a specific room ---
Customer      "1"    -- "0..*" WaitingListEntry
WaitingListEntry "0..*" -- "1" RoomType
WaitingListEntry "0..*" -- "1" Hotel
@enduml