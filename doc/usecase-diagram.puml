@startuml UseCases
title Use Case Diagram — Hotel Chain Reservation System
left to right direction
skinparam packageStyle rectangle

actor "Unregistered User" as Guest
actor "Registered User"   as RegUser
actor "Hotel Worker"      as Worker
actor "Banking System"    as Bank

RegUser --|> Guest

rectangle "Hotel Reservation System" {
  usecase "Query room availability"      as UC_Query
  usecase "Register"                     as UC_Register
  usecase "Make reservation"             as UC_Reserve
  usecase "Pay 20% advance"              as UC_Pay20
  usecase "Join waiting list"            as UC_Wait
  usecase "Perform check-in"             as UC_CheckIn
  usecase "Deliver access cards"         as UC_Cards
  usecase "Charge remaining 80%"         as UC_Pay80
  usecase "Record entry date"            as UC_RecIn
  usecase "Perform check-out"            as UC_CheckOut
  usecase "Record exit date"             as UC_RecOut
  usecase "Charge late-checkout fee"     as UC_PayLate
}

' --- Guest ---
Guest   --> UC_Query
Guest   --> UC_Register

' --- Registered user ---
RegUser --> UC_Reserve
RegUser --> UC_Wait

UC_Reserve ..> UC_Query : <<include>>
UC_Reserve ..> UC_Pay20 : <<include>>
UC_Wait    ..> UC_Reserve : <<extend>>\n(no availability)

' --- Worker ---
Worker  --> UC_CheckIn
Worker  --> UC_CheckOut

UC_CheckIn  ..> UC_Cards  : <<include>>
UC_CheckIn  ..> UC_Pay80  : <<include>>
UC_CheckIn  ..> UC_RecIn  : <<include>>

UC_CheckOut ..> UC_RecOut  : <<include>>
UC_CheckOut ..> UC_PayLate : <<extend>>\n(exit after 13:00)

' --- External system ---
UC_Pay20   --> Bank
UC_Pay80   --> Bank
UC_PayLate --> Bank
@enduml